<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string></string>
            <key>footerText</key>
            <string>WARNING</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.brend0n.unity60fpspref</string>
            <key>key</key>
            <string>enabled</string>
            <key>label</key>
            <string>ENABLED</string>
            <key>PostNotification</key>
            <string>com.brend0n.unity60fpspref/loadPref</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSLinkListCell</string>
            <key>defaults</key>
            <string>com.brend0n.unity60fpspref</string>
            <key>label</key>
            <string>CHOOSE_ENABLED_APP</string>
            <key>detail</key>
            <string>ATLApplicationListMultiSelectionController</string>
            <key>key</key>
            <string>apps</string>
            <key>sections</key>
            <array>
                <dict>
                    <key>sectionType</key>
                    <string>Visible</string>
                </dict>
            </array>
            <key>showIdentifiersAsSubtitle</key>
            <true/>
            <key>defaultApplicationSwitchValue</key>
            <false/>
            <key>useSearchBar</key>
            <true/>
            <key>includeIdentifiersInSearch</key>
            <true/>
            <key>PostNotification</key>
            <string>com.brend0n.unity60fpspref/loadPref</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string></string>
            <key>footerText</key>
            <string>DESCRIPTION</string>
        </dict>

        <!-- [FIX] Đổi sang PSLinkListCell: user chỉ chọn được giá trị hợp lệ,
             không thể nhập 0/-1/99999 gây crash hoặc bị anti-cheat phát hiện -->
        <dict>
            <key>cell</key>
            <string>PSLinkListCell</string>
            <key>defaults</key>
            <string>com.brend0n.unity60fpspref</string>
            <key>key</key>
            <string>customFps</string>
            <key>label</key>
            <string>CUSTOM_FPS</string>
            <key>detail</key>
            <string>PSListItemsController</string>
            <key>default</key>
            <integer>60</integer>
            <key>validValues</key>
            <array>
                <integer>30</integer>
                <integer>60</integer>
                <integer>90</integer>
                <integer>120</integer>
                <integer>144</integer>
            </array>
            <key>validTitles</key>
            <array>
                <string>30 FPS</string>
                <string>60 FPS</string>
                <string>90 FPS</string>
                <string>120 FPS</string>
                <string>144 FPS</string>
            </array>
            <key>PostNotification</key>
            <string>com.brend0n.unity60fpspref/loadPref</string>
        </dict>
    </array>
    <key>title</key>
    <string>Unity60FPS</string>
</dict>
</plist>
